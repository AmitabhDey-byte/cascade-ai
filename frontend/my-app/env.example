# Server-only URL used by app/api/[...path] to proxy browser API requests.
# In Vercel, set this to the deployed backend URL (for example,
# https://cascade-api.vercel.app). Do not add a trailing slash.
CASCADE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MAPBOX_TOKEN=
# Local development accepts any non-empty credentials unless this is false.
LOCAL_AUTH_BYPASS=true
# Set all three values in Vercel to require a specific account.
CASCADE_AUTH_EMAIL=
CASCADE_AUTH_PASSWORD=
CASCADE_AUTH_SECRET=
